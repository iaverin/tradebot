# ===================================
# Prediction Markets Backend - Environment Variables
# ===================================
# Copy this file to .env and update with your actual values
# Never commit the .env file to version control!

# Proxy
PROXY_USE_SSL=true
# if Proxy_host "" will be no proxy used
PROXY_HOST=xxxx.com
PROXY_PORT=443
PROXY_USERNAME=xxxx
PROXY_PASSWORD=xxxxx


# -----------------------------------
# Database Configuration
# -----------------------------------
# PostgreSQL connection string
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trading_desk

# Database credentials
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Maximum number of connections in the application database pool
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=40


# -----------------------------------
# JWT Configuration
# -----------------------------------
# Secret key for JWT token signing
# IMPORTANT: Use a strong random string in production (minimum 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits

# JWT token expiration time in milliseconds
# Default: 86400000 ms = 24 hours
JWT_EXPIRATION=86400000

# -----------------------------------
# Server Configuration
# -----------------------------------
# HTTP server port
SERVER_PORT=8080

# -----------------------------------
# Temporal Configuration
# -----------------------------------
# gRPC address of the Temporal server
TEMPORAL_TARGET_ENDPOINT=localhost:7233

# Temporal namespace (default is fine for local dev)
TEMPORAL_NAMESPACE=default

# Maximum execution time for the find-similar-markets child workflow (Spring Duration format)
SIMILAR_MARKETS_WORKFLOW_EXECUTION_TIMEOUT=3h

# -----------------------------------
# Fetcher Cron Schedule
# -----------------------------------
# Standard 5-field cron format (min hr dom mon dow) in UTC
# Default: 0 0 * * * = midnight UTC every day
# NOTE: This is NOT Quartz 6-field format (no leading seconds field)
#FETCHER_CRON_STRING_UTC=0 0 * * *

# -----------------------------------
# Kalshi Configuration
# -----------------------------------
# Kalshi API key (UUID)
#KALSHI_API_KEY=your-kalshi-api-key

# Maximum simultaneously active order-pair attempts for one exact PM/KS market pair
#ACTIVE_PAIRS_LIMIT=1

# Current portfolio position snapshots (optional)
#POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
#PORTFOLIO_POSITIONS_SCHEDULING_ENABLED=true
#PORTFOLIO_POSITIONS_REFRESH_DELAY_MS=300000
#PORTFOLIO_POSITIONS_INITIAL_DELAY_MS=0

# Kalshi RSA private key (base64-encoded, single line, no PEM headers)
# Generate from PEM: tr -d '\n' < kalshi_private_key.pem | sed 's/-----BEGIN RSA PRIVATE KEY-----//' | sed 's/-----END RSA PRIVATE KEY-----//'
#KALSHI_PRIVATE_KEY=your-kalshi-private-key-base64

# -----------------------------------
# opinion.trade Configuration
# -----------------------------------
# Sent as the `apikey` header on every opinion.trade Open API request
#OPINION_API_KEY=your-opinion-api-key
# Override the API host (default: https://openapi.opinion.trade/openapi)
#OPINION_BASE_URL=https://openapi.opinion.trade/openapi

# -----------------------------------
# Spring Profiles (Optional)
# -----------------------------------
# Activate specific Spring profiles (comma-separated)
# Examples: dev, prod, staging
#SPRING_PROFILES_ACTIVE=dev
